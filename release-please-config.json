{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "herdr-plugin.toml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
